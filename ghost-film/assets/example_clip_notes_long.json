 "d1": {
  "clip": "clips/d1_s81.mp4",
  "offset": 2.5,
  "talk": [
   [
    3.18,
    5.58,
    "「妳請一個禮拜假，老闆不會罵喔？」"
   ],
   [
    6.34,
    8.34,
    "「會啊，所以妳要乖乖好起來。」"
   ]
  ],
  "end": 8.6
 },
 "nq": {
  "clip": "clips/nq_s82.mp4",
  "offset": 2.93,
  "talk": [
   [
    3.0,
    4.34,
    "「家屬吃的，不要跟別人講。」"
   ],
   [
    5.36,
    7.38,
    "「阿琪，隔壁那床怎麼都拉著？」"
   ],
   [
    7.68,
    9.2,
    "「剛清完，等新病人。」"
   ]
  ],
  "end": 9.55
 },
