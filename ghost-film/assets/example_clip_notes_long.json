 },
 "c12": {
  "clip": "clips/c12_s81.mp4",
  "offset": 2.45,
  "talk": [
   [
    2.58,
    5.48,
    "「阿琪，我的拖鞋跑到隔壁床底下了。」"
   ],
   [
    6.04,
    7.52,
    "「妳晚上睡過去一點，不要靠那邊。」"
   ],
   [
    8.02,
    9.42,
    "「蛤？為什麼？」"
   ],
   [
    9.68,
    10.1,
    "「沒有為什麼。」"
   ]
  ],
  "end": 10.15
 },
 "n3": {
  "clip": "clips/n3_s81.mp4",
  "offset": 0.0,
  "talk": [
   [
    4.46,
    5.08,
    "「妳幹嘛？」"
   ],
   [
    6.06,
    8.7,
    "「沒啦，冷氣太冷。」"
   ]
  ],
  "end": 9.8
